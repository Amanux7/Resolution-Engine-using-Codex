# Default local and test mode. No API key is required.
AI_MODE=mock

# Optional server-only multimodal image extraction.
# Set AI_MODE=openai only after adding a project key locally.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Local persistence/storage remain the default for development and tests.
PERSISTENCE_PROVIDER=local
STORAGE_PROVIDER=local

# Hosted Vercel + Supabase mode (server-only; never prefix these with NEXT_PUBLIC_).
# PERSISTENCE_PROVIDER=supabase
# STORAGE_PROVIDER=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=resolution-evidence
